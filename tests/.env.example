# Required SIP credentials (must match the CRM app user's SIP identity)
SIP_USERNAME=
SIP_PASSWORD=
SIP_DOMAIN=
SIP_HOST=voip.in1.exotel.com
SIP_PORT=443

# Optional SIP fields (defaults match CRM WebSDK)
SIP_DISPLAY_NAME=
SIP_SECURITY=wss
SIP_ENDPOINT=wss

# Negative-path overrides (defaults applied if empty)
SIP_BAD_PASSWORD=definitely-wrong-password
SIP_BAD_DOMAIN=invalid.example.invalid

# Suite mode: auto (default) | full
mode=auto

# Real host mic/speakers (headed Chrome, no fake media device). DEV-01 then waits for physical plug.
# PARITY_REAL_MEDIA=1

# Harness URL (must match playwright webServer)
PARITY_BASE_URL=http://127.0.0.1:4173

# Manual-step wait in mode=full (ms)
PARITY_MANUAL_TIMEOUT_MS=120000

# Optional — CRM / integrationscore MakeCall (same as CRM sample app)
# Enables unattended CALL-IN / CALL-OUT. Without these, call/control tests skip in mode=auto.
#
# Same inputs as ExotelCRMWebSDK(accessToken, userId) + MakeCall(to):
#   ICORE_ACCESS_TOKEN — app access token (Authorization header as-is)
#   ICORE_USER_ID      — AppUserId (usermapping resolves customer_id + app_id)
#   ICORE_TO           — destination PSTN (E.164 preferred, e.g. +91XXXXXXXXXX)
# SIP_* user must be the SIP identity for ICORE_USER_ID
ICORE_ACCESS_TOKEN=
ICORE_USER_ID=
ICORE_TO=
# Exophone / VirtualNumber for the app user (required for outbound_call)
ICORE_VIRTUAL_NUMBER=
ICORE_BASE_URL=https://integrationscore.mum1.exotel.com

# Optional overrides (normally fetched from usermapping)
# ICORE_CUSTOMER_ID=
# ICORE_APP_ID=
